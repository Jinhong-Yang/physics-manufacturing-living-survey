      "text_path": "runs/wp1/fulltext_acquisition_20261011/W_neurips_2025_3933b264379fb08f/main_extracted_fonttools.txt",
      "text_sha256": "35f496eda0257a08dfeefecca7afa7996d746fce305a529267be34c0f09e91ab",
      "pages": 14,
      "method": "PhysX-3D / PhysXGen",
      "read_scope": "All official PDF text including references/appendix/checklist; selected figures/equations/tables visually inspected.",
      "read_by": "same_AI_unblinded",
      "independent_review": false,
      "prior_complete_arxiv_reading_already_exists": false,
      "graph_work_alias": null,
      "screening_disposition": "H2_pending_independent_human_scope_adjudication",
      "coupling_codes": [
        "C2",
        "C3"
      ],
      "verification_codes": [
        "V2_property_annotation_agreement"
      ],
      "manufacturing_codes": [
        "M0_general_physical_asset"
      ],
      "classification_caveat": "Property-supervised C2/C3 does not mean governing-equation enforcement; reported V3/M3 is upstream lab evidence, not independent replication by this review.",
      "claims": [
        {
          "id": "P01",
          "pages": [
            1,
            2,
            3
          ],
          "locus": "Abstract; Sec1; Table1",
          "statement": "PhysXNet supplies about26K part-annotated objects and PhysXNet-XL more than6million procedural objects; these are author-reported dataset totals.",
          "evidence_origin": "author_reported"
        },
        {
          "id": "P02",
          "pages": [
            4,
            5
          ],
          "locus": "Sec3.1-3.2 Fig2",
          "statement": "The annotation pipeline combines GPT-4o estimates, human review, contact-region/plane fitting and human selection of kinematic parameters; homogeneous part composition is assumed.",
          "evidence_origin": "author_reported"
        },
        {
          "id": "P03",
          "pages": [
            5
          ],
          "locus": "Sec3.1",
          "statement": "The annotation vocabulary includes scale, material descriptors, affordance, joint types and function descriptions. Prismatic movement range is represented in3D coordinates because exact physical movement is difficult to quantify.",
          "evidence_origin": "author_reported"
        },
        {
          "id": "P04",
          "pages": [
            6,
            7
          ],
          "locus": "Sec4.1 Eq1-2",
          "statement": "The generative physical input contains14numeric channels: scale,affordance,density and11kinematic channels. Listed material descriptors should not be confused with directly generated constitutive parameters.",
          "evidence_origin": "author_reported"
        },
        {
          "id": "P05",
          "pages": [
            7
          ],
          "locus": "Sec4.1",
          "statement": "Semantic descriptions use three768-dimensional CLIP embeddings; geometric features use1024-dimensional DINOv2 features; physical and structured latents each have8channels.",
          "evidence_origin": "author_reported"
        },
        {
          "id": "P06",
          "pages": [
            7
          ],
          "locus": "Sec4 Eq2-3",
          "statement": "Dual-branch VAE/conditional-flow-matching training supervises property agreement and structural appearance/geometry, rather than enforcing a FEM or measured process equation.",
          "evidence_origin": "author_reported"
        },
        {
          "id": "P07",
          "pages": [
            8
          ],
          "locus": "Sec5.1",
          "statement": "The reported split is24K training,1Kvalidation and1Ktest, with AdamW1e-4 and8A100GPUs for training; this is not an inference resource requirement.",
          "evidence_origin": "author_reported"
        },
        {
          "id": "P08",
          "pages": [
            8
          ],
          "locus": "Sec5.2",
          "statement": "Scale uses Euclidean distance; density,affordance and semantic-similarity maps use PSNR; kinematics use instantiation distance; geometry uses CD and F-score.",
          "evidence_origin": "author_reported"
        },
        {
          "id": "P09",
          "pages": [
            8
          ],
          "locus": "Table2",
          "statement": "Against TRELLIS+PhysPre, PhysXGen reports scale error13.21to7.24, material PSNR8.63to13.01, affordance7.23to11.30, kinematic COV0.24to0.33 and MMD0.12to0.08, and description6.55to10.11.",
          "evidence_origin": "author_reported"
        },
        {
          "id": "P10",
          "pages": [
            8
          ],
          "locus": "Table2",
          "statement": "Geometry PSNR changes24.31to24.53, CD13.2to12.7 and F-score76.9to77.3. CD is scaled by1e-3 and F-score by1e-2 in the metric description.",
          "evidence_origin": "author_reported"
        },
        {
          "id": "P11",
          "pages": [
            9,
            10
          ],
          "locus": "Sec5.3-6 Table3",
          "statement": "Ablations evaluate branch dependencies; limitations include fine-grained property errors and artifacts. No manufacturing-process qualification threshold is supplied.",
          "evidence_origin": "author_reported"
        },
        {
          "id": "P12",
          "pages": [
            13
          ],
          "locus": "Checklist7",
          "statement": "Authors explicitly report no repeated experiments because of benchmark cost; point improvements do not establish an independent significance test.",
          "evidence_origin": "author_reported"
        },
        {
          "id": "P13",
          "pages": [
            13,
            14
          ],
          "locus": "Checklist5/12",
          "statement": "The paper describes code/examples and prospective full-data release and asserts license compliance; release-time asset-level terms must be observed separately.",
          "evidence_origin": "author_reported"
        }
      ],
