      "pdf_url": "https://proceedings.neurips.cc/paper_files/paper/2025/file/86beeac1799c083e4597d4aa17385a25-Paper-Conference.pdf",
      "pdf_path": "runs/wp1/fulltext_acquisition_20261011/W_neurips_2025_3933b264379fb08f/main.pdf",
