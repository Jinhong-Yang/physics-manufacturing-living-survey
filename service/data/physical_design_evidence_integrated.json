      "classification_caveat": "Property-supervised C2/C3 does not mean governing-equation enforcement; reported V3/M3 is upstream lab evidence, not independent replication by this review.",
      "claims": [
        {
          "id": "T01",
          "pages": [
            1,
            5,
            6,
            7
          ],
          "locus": "Abstract; Sec3; Eq5",
          "statement": "TIDES jointly optimizes a material-density design with SIMP finite-element compliance, a CLIP visual objective and a material-cost penalty.",
          "evidence_origin": "author_reported"
        },
        {
          "id": "T02",
          "pages": [
            3,
            4
          ],
          "locus": "Sec2.1 Eq1-3",
          "statement": "The design uses continuous densities and modified SIMP with p=3; compliance is U^T K U, while material cost is an absolute density-target difference.",
          "evidence_origin": "author_reported"
        },
        {
          "id": "T03",
          "pages": [
            5,
            6
          ],
          "locus": "Sec3 Eq4",
          "statement": "A heuristic Hill-style transform uses alpha0.8 and n20 to push densities toward binary material/void values.",
          "evidence_origin": "author_reported"
        },
        {
          "id": "T04",
          "pages": [
            6
          ],
          "locus": "Sec3 Fig2",
          "statement": "A compliance-derived mask thresholds log(element compliance) at -20 before presenting the design to CLIP.",
          "evidence_origin": "author_reported"
        },
        {
          "id": "T05",
          "pages": [
            6,
            7
          ],
          "locus": "Sec3",
          "statement": "The design is repeated into three grayscale channels, resized to224x224 and augmented with random crops/perspectives; autograd FEM gradients are wrapped for PyTorch.",
          "evidence_origin": "author_reported"
        },
        {
          "id": "T06",
          "pages": [
            7,
            14
          ],
          "locus": "Sec4.1; AppendixB.1",
          "statement": "Resolution experiments include64,128,256,512-square designs; tower optimization uses target density0.3, weights50/100, AdamW learning rate0.25 and100epochs.",
          "evidence_origin": "author_reported"
        },
        {
          "id": "T07",
          "pages": [
            8,
            19,
            20,
            21,
            22,
            23,
            24,
            25,
            26
          ],
          "locus": "Sec4.2 Fig4; AppendixC.5-C.6",
          "statement": "Bridge and hoop distributions use30trials per prompt with physics-only baselines; reported ellipses are90% confidence ellipses, not specimen error bars.",
          "evidence_origin": "author_reported"
        },
        {
          "id": "T08",
          "pages": [
            14,
            15
          ],
          "locus": "AppendixB.2-B.3",
          "statement": "The appendix prompt lists repeat triangle while the main text includes arch, hexagon and triangle; retain the source configuration discrepancy.",
          "evidence_origin": "author_reported"
        },
        {
          "id": "T09",
          "pages": [
            9,
            10
          ],
          "locus": "Sec4.4 Fig6",
          "statement": "Three printed replicates per tested design are reported. Force-displacement points are means and bars are observed minima/maxima across three replicates.",
          "evidence_origin": "author_reported"
        },
        {
          "id": "T10",
          "pages": [
            15
          ],
          "locus": "AppendixB.4",
          "statement": "The beam design grid is672x96 with density0.5, weights50/100, AdamW0.25 and100epochs; symmetry is used to evaluate half the domain.",
          "evidence_origin": "author_reported"
        },
        {
          "id": "T11",
          "pages": [
            15
          ],
          "locus": "AppendixB.4",
          "statement": "Printing uses MarkforgedX7 and short-carbon-fiber-filled Onyx nylon, alternating +/-45degree infill,200micron path width and100micron layer height.",
          "evidence_origin": "author_reported"
        },
        {
          "id": "T12",
          "pages": [
            15
          ],
          "locus": "AppendixB.4",
          "statement": "The reported bending setup uses displacement control at1mm/min and a20kN load cell.",
          "evidence_origin": "author_reported"
        },
        {
          "id": "T13",
          "pages": [
            9,
            10
          ],
          "locus": "Sec4.4",
          "statement": "The physical curves are described as similar in0-1.5mm displacement and diverging later; small-feature path-termination voids may reduce stiffness and strength.",
          "evidence_origin": "author_reported"
        },
        {
          "id": "T14",
          "pages": [
            9,
            10
          ],
          "locus": "Sec4.4",
          "statement": "As printed, laboratory compliance values are physics-only1.0e-3, honeycomb1.13e-3 and arch1.19e-3, with the paper displaying N/mm.",
          "evidence_origin": "author_reported"
        },
        {
          "id": "T15",
          "pages": [
            10
          ],
          "locus": "Sec4.4",
          "statement": "Simulation compliance values are physics-only280.0, arch285.71 and honeycomb299.55. The arch/honeycomb ordering reverses between these reported domains.",
          "evidence_origin": "author_reported"
        },
        {
          "id": "T16",
          "pages": [
            3,
            9,
            10
          ],
          "locus": "Eq2; Sec4.4",
          "statement": "The displayed N/mm unit requires clarification for compliance; do not silently convert it or pool it with solver U^T K U values. This is a dimensional-consistency inference, not an author correction.",
          "evidence_origin": "reviewer_inference"
        },
        {
          "id": "T17",
          "pages": [
            14
          ],
          "locus": "AppendixA-B.1",
          "statement": "The simulator limits3D design to layered2D force applications; a manual cleanup pass is described for tower designs, so full automation should not be assumed.",
          "evidence_origin": "author_reported"
        },
        {
          "id": "T18",
          "pages": [
            29,
            30,
            31,
            32
          ],
          "locus": "Checklist5/8/12/13",
          "statement": "Code release is described prospectively; hardware is RTX A4000,32GBRAM and Intel i7. Permissive dependency-license statements do not supply a TIDES release identity or grant.",
          "evidence_origin": "author_reported"
        }
